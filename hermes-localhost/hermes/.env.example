NODE_ENV=development
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=info
PRETTY_LOGS=true
API_BASE_PATH=/api/v1

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hermes_api
REDIS_URL=redis://127.0.0.1:6379

HERMES_URL=http://hermes:8642
HERMES_API_KEY=
# Timeout por intento contra Hermes: 10800000 ms = 180 min (tareas agénticas largas).
HERMES_TIMEOUT_MS=10800000
# Legacy sin efecto: el cliente Hermes no reintenta (retries: 0). Sin reintento automático.
HERMES_RETRIES=0
HERMES_CIRCUIT_FAILURE_THRESHOLD=5
HERMES_CIRCUIT_COOLDOWN_MS=10000

JWT_ACCESS_SECRET=local-jwt-access-secret-not-used-by-local-mode
JWT_REFRESH_SECRET=local-jwt-refresh-secret-not-used-by-local-mode
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
JWT_ISSUER=hermes-api

# Secret para acceder a /documentation (Swagger UI). Si está vacío, la documentación
# queda pública (solo para desarrollo). En producción fija un valor fuerte.
DOCS_SECRET=
# Origen permitido por CORS en producción: Tauri v2 (https://tauri.localhost).
# En dev, añadir el dev server (p. ej. http://localhost:1420) separado por comas.
CORS_ORIGINS=https://tauri.localhost
# Bind del puerto publicado en compose (API_BIND_ADDRESS). 127.0.0.1 = solo este host;
# IP Tailscale del host (p. ej. 100.85.218.105) = accesible desde la VPN privada.
# El compose publica AMBOS binds (loopback + Tailscale) para diagnóstico local.
API_BIND_ADDRESS=100.85.218.105
LOCAL_USER_NICKNAME=john
LOCAL_USER_PASSWORD=44349989

OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_MAX_ATTEMPTS=5
OUTBOX_RETRY_BASE_MS=200

WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_RETRY_BASE_MS=200
WEBHOOK_TIMEOUT_MS=10000
QUOTA_FREE_REQUESTS=1000000000
QUOTA_FREE_TOKENS=1000000000000
QUOTA_PRO_REQUESTS=1000000000000
QUOTA_PRO_TOKENS=1000000000000
MAX_INPUT_TOKENS=0

# Conexión hermes↔ollama por task (fallback de hermes-api cuando el front no manda
# base_url/api_key por task). OLLAMA_BASE_URL es OBLIGATORIA: sin ella el backend
# no arranca ("NO DATA TO CONNECT FROM HERMES"). OLLAMA_API_KEY es OPCIONAL (vacía
# permitida; el proveedor puede no requerir clave).
OLLAMA_BASE_URL=http://194.228.55.129:36327/v1
OLLAMA_API_KEY=

OUTPUT_FILE_DIR=/hermes-outputs
TASK_OUTPUT_FILE_MAX_BYTES=20971520

# --- APNs (push iOS) ---
# Con APNS_KEY_P8/APNS_KEY_ID/APNS_TEAM_ID vacíos el push queda desactivado (Noop).
# APNS_ENV: 'sandbox' (desarrollo/TestFlight) o 'production' (App Store).
# APNS_KEY_P8: contenido PEM de la clave .p8 de Apple. En .env, envolver en comillas
# dobles con saltos de línea como \n (dotenv los interpreta).
APNS_ENV=sandbox
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=dev.ucreaccion.app
