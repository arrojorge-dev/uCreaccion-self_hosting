generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum Plan {
    FREE
    PRO
}

enum TaskStatus {
    PENDING
    ENQUEUED
    RUNNING
    SUCCEEDED
    FAILED
    CANCELLED
}

enum MessageRole {
    USER
    ASSISTANT
    TOOL
    SYSTEM
}

enum WebhookDeliveryStatus {
    PENDING
    DELIVERED
    FAILED
    DEAD
}

enum OutboxStatus {
    PENDING
    DISPATCHED
    FAILED
    DEAD
}

enum ActorType {
    USER
    API_KEY
    SYSTEM
}

enum UsageKind {
    REQUESTS
    TOKENS
}

model User {
    id            String   @id @default(uuid())
    nickname      String   @unique
    passwordHash  String
    name          String?
    plan          Plan     @default(FREE)
    createdAt     DateTime @default(now())
    updatedAt     DateTime @updatedAt

    authSessions      AuthSession[]
    apiKeys           ApiKey[]
    projects          Project[]
    conversations     Conversation[]
    tasks             Task[]
    webhooks          Webhook[]
    notifications     Notification[]
    auditLogs         AuditLog[]
    usageRecords      UsageRecord[]
    idempotencyKeys   IdempotencyKey[]
}

model AuthSession {
    id                String    @id @default(uuid())
    userId            String
    refreshTokenHash  String    @unique
    ip                String?
    userAgent         String?
    device            String?
    rotatedFromId     String?
    expiresAt         DateTime
    revokedAt         DateTime?
    createdAt         DateTime  @default(now())

    user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    rotatedFrom  AuthSession?  @relation("TokenRotation", fields: [rotatedFromId], references: [id])
    rotatedTo    AuthSession[] @relation("TokenRotation")

    @@index([userId])
}

model ApiKey {
    id           String    @id @default(uuid())
    userId       String
    name         String
    keyHash      String    @unique
    prefix       String
    scopes       String[]
    lastUsedAt   DateTime?
    expiresAt    DateTime?
    revokedAt    DateTime?
    createdAt    DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model Project {
    id          String   @id @default(uuid())
    userId      String
    name        String
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
    conversations Conversation[]

    @@index([userId, createdAt])
}

model Conversation {
    id               String    @id @default(uuid())
    userId           String
    projectId        String?
    title            String?
    hermesSessionId  String?   @unique
    createdAt        DateTime  @default(now())
    lastUsedAt       DateTime  @default(now())

    user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    project  Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
    messages Message[]
    tasks    Task[]

    @@index([userId, lastUsedAt])
}

model Message {
    id               String     @id @default(uuid())
    conversationId   String
    role             MessageRole
    content          String
    metadata         Json?
    createdAt        DateTime   @default(now())

    conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

    @@index([conversationId, createdAt])
}

model Task {
    id                String        @id @default(uuid())
    userId            String
    conversationId    String?
    status            TaskStatus    @default(PENDING)
    idempotencyKey    String?
    inputPayload      Json
    resultPayload     Json?
    hermesSessionId   String?
    tokensIn          Int?
    tokensOut         Int?
    attempt           Int           @default(0)
    maxAttempts       Int           @default(3)
    lastError         Json?
    nextAttemptAt     DateTime?
    stream            Boolean       @default(false)
    startedAt         DateTime?
    completedAt       DateTime?
    cancelledAt       DateTime?
    createdAt         DateTime      @default(now())
    updatedAt         DateTime      @updatedAt

    user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
    conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

    @@unique([userId, idempotencyKey])
    @@index([userId, createdAt])
    @@index([status, createdAt])
}

model Webhook {
    id         String   @id @default(uuid())
    userId     String
    url        String
    secret     String
    events     String[]
    active     Boolean  @default(true)
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
    deliveries WebhookDelivery[]

    @@index([userId])
}

model WebhookDelivery {
    id               String                @id @default(uuid())
    webhookId        String
    outboxMessageId  String?
    eventType        String
    payload          Json
    status           WebhookDeliveryStatus @default(PENDING)
    attempts         Int                   @default(0)
    responseStatus   Int?
    lastError        String?
    nextAttemptAt    DateTime?
    createdAt        DateTime              @default(now())
    deliveredAt      DateTime?

    webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

    @@unique([webhookId, outboxMessageId])
    @@index([status, nextAttemptAt])
    @@index([webhookId, createdAt])
}

model Notification {
    id               String    @id @default(uuid())
    userId           String
    outboxMessageId  String?   @unique
    type             String
    title            String
    body             String?
    payload          Json?
    readAt           DateTime?
    createdAt        DateTime  @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId, readAt, createdAt])
}

model AuditLog {
    id            String     @id @default(uuid())
    userId        String?
    actorType     ActorType
    actorId       String?
    action        String
    resourceType  String?
    resourceId    String?
    context       Json?
    ip            String?
    requestId     String?
    createdAt     DateTime   @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt])
    @@index([createdAt])
}

model UsageRecord {
    id             String     @id @default(uuid())
    userId         String?
    taskId         String?
    kind           UsageKind
    amount         Int
    tokensIn       Int?
    tokensOut      Int?
    model          String?
    currencyCents  Int?
    createdAt      DateTime   @default(now())

    user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

    @@index([userId, createdAt])
    @@index([createdAt])
}

model OutboxMessage {
    id             String       @id @default(uuid())
    aggregateType  String
    aggregateId    String
    type           String
    payload        Json
    status         OutboxStatus @default(PENDING)
    attempts       Int          @default(0)
    lastError      String?
    nextAttemptAt  DateTime?
    createdAt      DateTime     @default(now())
    dispatchedAt   DateTime?

    @@index([status, nextAttemptAt])
    @@index([createdAt])
}

model IdempotencyKey {
    id            String   @id @default(uuid())
    userId        String
    key           String
    resourceType  String
    resourceId    String
    createdAt     DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@unique([userId, key])
}

model DeviceToken {
    id        String   @id @default(uuid())
    token     String   @unique
    platform  String   @default("ios")
    env       String   @default("production")
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([env])
}
